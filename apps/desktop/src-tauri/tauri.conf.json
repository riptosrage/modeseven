{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode 7",
  "version": "0.1.0",
  "identifier": "app.modeseven.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../testbed -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../testbed",
    "frontendDist": "../../testbed/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mode 7",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "A pegboard for building your own tools",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
